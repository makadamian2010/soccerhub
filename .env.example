# Keep real credentials in a local .env file or your hosting provider's secret manager.
# Create this token in your Sportmonks Football API account. Never expose it in browser code.
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# Set this only when the Sportmonks Predictions add-on is active on the same token.
# The app will show "No verified win probability" when the add-on is unavailable.
SPORTMONKS_PREDICTIONS_ENABLED=true
